# Local environment for docker-compose.yml. Copy to .env and adjust:
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This file is tracked and must only
# ever contain placeholders or local-only defaults.
#
# Compose substitutes only into the variables listed under `environment:` in docker-compose.yml, so a
# name added here that the compose file does not pass is silently ignored. The list there is: the three
# POSTGRES_* below, the three RATES_* below, SPRING_PROFILES_ACTIVE and DEPLOYMENT_ENVIRONMENT.

# Credentials for the Postgres container in docker-compose.yml.
POSTGRES_DB=financial
POSTGRES_USER=financial
POSTGRES_PASSWORD=financial

# The external rates provider. Twelve Data: https://twelvedata.com/pricing
#
RATES_API_BASE_URL=https://api.twelvedata.com
RATES_API_KEY=

# Written into currency_rate.source, so a local run is distinguishable from a deployment's data.
RATES_SOURCE=twelvedata

# prod by default so the container runs the same thread, pool and health settings a deployment does.
# Use dev for a local container when you want DEBUG logging and lifted quotas.
SPRING_PROFILES_ACTIVE=prod

# Tags the metrics so one dashboard can hold several deployments without relabelling anything.
DEPLOYMENT_ENVIRONMENT=local