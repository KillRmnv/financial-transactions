<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured logs in the profile that ships, readable ones everywhere else.

  A line in the pattern layout is a string an operator reads; a line in the structured
  layout is a document a log aggregator can index, which is the whole reason for the
  second format — "every 500 from the rates provider since the deploy" is a query rather
  than a grep across a file that has already rotated.

  Readable is deliberately the default rather than the exception. JSON in a terminal
  makes the logs of a scenario unreadable while it is being written, and the people who
  need them to be readable are the ones debugging a failing test.

  The encoder is Spring Boot's own, which is why this file has no extra dependency: it
  writes the message, the level, the logger, the timestamp and the exception stack as
  fields, and it is the same code the default configuration would have used.
-->
<configuration>

	<springProfile name="prod">
		<appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
			<encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder"/>
		</appender>
		<root level="INFO">
			<appender-ref ref="JSON"/>
		</root>
	</springProfile>

	<springProfile name="!prod">
		<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
			<encoder>
				<pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
			</encoder>
		</appender>
		<root level="INFO">
			<appender-ref ref="CONSOLE"/>
		</root>
	</springProfile>

</configuration>
