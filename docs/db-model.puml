@startuml db-model
hide circle
skinparam defaultFontSize 12
skinparam nodesep 70
skinparam ranksep 110
left to right direction

entity "currency" as currency {
  id           : smallserial   <<PK>>
  --
  code         : varchar(3)    <<UQ>>
  display_name : varchar(64)
  created_at   : timestamptz
}

entity "expense_category" as expense_category {
  id           : smallserial   <<PK>>
  --
  code         : varchar(32)   <<UQ>>
  display_name : varchar(128)
}

entity "currency_pair" as currency_pair {
  id            : bigserial   <<PK>>
  --
  base_currency : varchar(3)  <<FK, UQ>>
  active        : boolean
  created_at    : timestamptz
}

entity "currency_rate" as currency_rate {
  id             : bigserial      <<PK>>
  --
  base_currency  : varchar(3)     <<FK>>
  rate_date      : date
  close          : numeric(19,8)  *
  previous_close : numeric(19,8)  *
  source         : varchar(32)
  fetched_at     : timestamptz
}

entity "expense_limit" as expense_limit {
  id           : bigserial     <<PK>>
  --
  account_from : varchar(10)
  category_id  : smallint      <<FK>>
  currency_id  : smallint      <<FK>>
  sum          : numeric(14,2)
  created_at   : timestamptz
  is_default   : boolean
}

entity "expense_transaction" as expense_transaction {
  id              : bigserial        <<PK>>
  --
  account_from    : varchar(10)
  account_to      : varchar(10)
  currency_id     : smallint         <<FK>>
  sum             : numeric(14,2)
  category_id     : smallint         <<FK>>
  occurred_at     : timestamptz
  occurred_month  : date
  --
  ledger_sum      : numeric(14,2)    *
  applied_rate    : numeric(19,8)    *
  rate_date       : date             *
  limit_id        : bigint           <<FK>>    *
  limit_exceeded  : boolean          *
  --
  flag_calculated : boolean
  created_at      : timestamptz
}

currency ||--o| currency_pair       : "is swept for"
currency ||--o{ currency_rate       : "has a rate for"
currency ||--o{ expense_limit       : "denominated in"
currency ||--o{ expense_transaction : "denominated in"
expense_category ||--o{ expense_limit       : "scoped to"
expense_category ||--o{ expense_transaction : "classified as"
expense_limit |o--o{ expense_transaction : "measured against"

@enduml
